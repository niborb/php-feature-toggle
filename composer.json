{
    "name": "niborb/php-feature-toggle",
    "description": "A PHP feature toggle library",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Robin Breuker",
            "email": "robin02@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/expression-language": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.1",
        "symfony/cache": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Niborb\\FeatureToggle\\": "src/Niborb/FeatureToggle/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Niborb\\FeatureToggle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
